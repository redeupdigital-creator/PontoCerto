# Banco de dados
# Para desenvolvimento local, deixe DB_DIALECT=sqlite (não precisa instalar nada).
DB_DIALECT=sqlite
DB_STORAGE=./data/ponto.sqlite

# Se DB_DIALECT=postgres (Docker/VPS/Render/Railway), preencha:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ponto_certo
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# Supabase + Vercel: defina DATABASE_URL (tem prioridade sobre DB_DIALECT/DB_HOST/etc
# acima) com a connection string do MODO TRANSACTION (porta 6543) da Supabase.
# Ver DEPLOY_SUPABASE_VERCEL.md para o passo a passo completo.
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Storage (fotos de colaborador). Sem isso configurado, o backend usa
# disco local (funciona em Docker/VPS, mas NÃO funciona na Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=fotos-colaboradores

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
# Timezone usado para calcular a hora exibida no relógio de ponto (bater ponto
# pelo app) e nos horários "HH:MM" registrados. Sem isso, o servidor usa o
# timezone padrão do sistema operacional (geralmente UTC), o que pode gerar
# horários incorretos em produção.
TZ=America/Sao_Paulo

# Notificações (opcional). Sem SMTP configurado, as notificações continuam
# sendo geradas normalmente, só que apenas no centro de notificações in-app
# (GET /api/notificacoes) — nenhum e-mail é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nao-responda@suaempresa.com
# E-mail que recebe o aviso de "novo abono pendente" (RH/gestor)
NOTIFICACAO_GESTOR_EMAIL=

